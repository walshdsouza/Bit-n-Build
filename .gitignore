# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
.venv/
__pycache__/
*.pyc


# test build output
tests/.build

# sign language datasets
# The raw downloaded .sigml corpora stay out of the repo (large, regenerable),
# but the COMPILED dictionaries are committed: lib/dictionaries/index.ts
# imports isl_dictionary.json statically, so without it the build fails on a
# fresh clone and on the deploy host.
/public/signs/*.sigml
/public/signs/lexicon.json
/data/datasets/*
!/data/datasets/*_dictionary.json

# local logs
/logs/
