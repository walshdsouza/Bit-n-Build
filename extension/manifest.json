{
  "manifest_version": 2,
  "name": "GestureSync AI — Sign Language Sidebar",
  "version": "0.1.0",
  "description": "Live ISL/ASL sign-language avatar for Google Meet, rendered in a persistent Firefox sidebar instead of an in-page overlay.",
  "author": "GestureSync AI",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "gesturesync-sidebar@REPLACE_ME.example",
      "strict_min_version": "112.0"
    }
  },

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "https://meet.google.com/*",
    "https://api.groq.com/*",
    "https://api.openai.com/*"
  ],

  "background": {
    "scripts": ["dist/background.js"],
    "persistent": false
  },

  "sidebar_action": {
    "default_title": "GestureSync AI",
    "default_panel": "dist/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },

  "browser_action": {
    "default_title": "Open GestureSync AI sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["dist/meet-bridge.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    "dist/*",
    "icons/*"
  ],

  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": false
  },

  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Toggle the GestureSync AI sidebar"
    }
  },

  "content_security_policy": "script-src 'self'; object-src 'self'; frame-src http://localhost:3000;"
}
