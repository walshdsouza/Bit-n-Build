{
  "manifest_version": 2,
  "name": "UNMUTE — Live Sign Language for Meet",
  "version": "0.3.0",
  "description": "Live ASL signs and captions in a draggable Google Meet widget, with an optional Firefox sidebar.",
  "author": "UNMUTE",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "{6ed1217e-a95c-4c32-ae05-2f7bfc2cf119}",
      "strict_min_version": "140.0",

      "data_collection_permissions": {
        "required": ["personalCommunications"],
        "optional": []
      }
    },

    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "https://meet.google.com/*",
    "https://unmute-ai.vercel.app/*"
  ],

  "background": {
    "scripts": ["dist/background.js"],
    "persistent": false
  },

  "sidebar_action": {
    "default_title": "UNMUTE",
    "default_panel": "dist/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },

  "browser_action": {
    "default_title": "Open UNMUTE sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["dist/meet-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["dist/meet-widget.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    "dist/*",
    "icons/*"
  ],

  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": false
  },

  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Toggle the UNMUTE sidebar"
    }
  },

  "content_security_policy": "script-src 'self'; object-src 'self'; frame-src 'self';"
}
